        },
        {
          "path": "registry/new-york/ui/layouts.css",
          "type": "registry:file",
          "target": "@ui/layouts.css"
        }
      ]
    },
    {
      "name": "cluster",
      "type": "registry:ui",
      "title": "Cluster",
      "description": "Horizontal flex wrap with alignment knobs. Use for toolbars, tags, and action rows. Always wraps.",
